[Unit]
Description=WeChat gateway for local Codex backends
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Environment=CODEX_WECHAT_SERVICE_CHILD=1
ExecStart=%h/.local/share/codex-wechat/codex-wechat start
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=graphical-session.target
