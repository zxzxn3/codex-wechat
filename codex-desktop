#!/usr/bin/env bash
# Stable version selection only. Proxy policy belongs to the caller's launcher.
set -euo pipefail
if [ "${EUID:-$(id -u)}" -eq 0 ] && [ "${CODEX_WECHAT_ALLOW_ROOT:-}" != "1" ]; then
    case "${1:-}" in
        -h|--help) ;;
        *)
            echo 'codex-desktop: 请以普通用户身份运行，不要使用 root/sudo 或管理员终端。' >&2
            exit 78
            ;;
    esac
fi
INSTALL_ROOT="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
export CODEX_WECHAT_INSTALL_ROOT="$INSTALL_ROOT"
PYTHON="$INSTALL_ROOT/.bootstrap-venv/bin/python"
if [ ! -x "$PYTHON" ]; then
    echo "codex-desktop: 稳定 Python 环境缺失；请重新运行 bootstrap。" >&2
    exit 1
fi
exec env CODEX_WECHAT_INSTALL_ROOT="$INSTALL_ROOT" \
    "$PYTHON" -u -m codex_wechat.launcher \
    --install-root "$INSTALL_ROOT" --module codex_wechat.desktop -- "$@"
