#!/usr/bin/env bash
# Preserve system PATH defaults while making the existing personal launchers available.
set -euo pipefail
INSTALL_ROOT="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
PROJECT_DIR="$INSTALL_ROOT"
CURRENT_FILE="$INSTALL_ROOT/current"
if [ "${EUID:-$(id -u)}" -eq 0 ] && [ "${CODEX_WECHAT_ALLOW_ROOT:-}" != "1" ]; then
    case "${1:-status}" in
        status|logs|uninstall|-h|--help) ;;
        *)
            echo "codex-wechat: 请以普通用户身份运行，不要使用 root/sudo。" >&2
            exit 78
            ;;
    esac
fi
case "${1:-}" in
    install|update|menu|components)
        INSTALLER="$INSTALL_ROOT/installer.py"
        if [ ! -f "$INSTALLER" ]; then
            echo "codex-wechat: 稳定安装器缺失: $INSTALLER" >&2
            exit 1
        fi
        exec python3 -u "$INSTALLER" "$@"
        ;;
esac
if [ -L "$CURRENT_FILE" ]; then
    echo "codex-wechat: current 不能是符号链接" >&2
    exit 1
fi
if [ -f "$CURRENT_FILE" ]; then
    IFS= read -r RELEASE_ID < "$CURRENT_FILE" || true
    if [[ ! "$RELEASE_ID" =~ ^[a-f0-9]{16}$ ]]; then
        echo "codex-wechat: current 文件包含无效版本标识" >&2
        exit 1
    fi
    PROJECT_DIR="$INSTALL_ROOT/releases/$RELEASE_ID"
    if [ ! -f "$PROJECT_DIR/codex_wechat.py" ]; then
        echo "codex-wechat: 当前版本不完整: $PROJECT_DIR" >&2
        echo "请从新源码重新运行 update。" >&2
        exit 1
    fi
    export CODEX_WECHAT_INSTALL_ROOT="$INSTALL_ROOT"
    export CODEX_WECHAT_DATA_ROOT="$INSTALL_ROOT"
fi
case "${1:-}" in
    cli)
        ACTION="$1"; shift
        exec "$INSTALL_ROOT/codex-desktop" "$ACTION" -- "$@"
        ;;
esac
export PATH="$HOME/.local/bin:$PATH"
PYTHON=python3
if [ -x "$PROJECT_DIR/.venv/bin/python" ]; then
    PYTHON="$PROJECT_DIR/.venv/bin/python"
fi
exec "$PYTHON" -u "$PROJECT_DIR/codex_wechat.py" "$@"
