#!/usr/bin/env bash
# Preserve system PATH defaults while making the existing personal launchers available.
set -euo pipefail
INSTALL_ROOT="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
PROJECT_DIR="$INSTALL_ROOT"
CURRENT_FILE="$INSTALL_ROOT/current"
DATA_ROOT_FILE="$INSTALL_ROOT/.data-root"
RUNTIME_ROOTS_FILE="$INSTALL_ROOT/.runtime-roots"
export CODEX_WECHAT_INSTALL_ROOT="$INSTALL_ROOT"
ACTION="${1:-status}"
case "$ACTION" in
    install|update|menu|components) INSTALLER_ACTION=1 ;;
    *) INSTALLER_ACTION=0 ;;
esac
if [ ! -e "$RUNTIME_ROOTS_FILE" ] &&
        { [ -e "$DATA_ROOT_FILE" ] || [ -L "$DATA_ROOT_FILE" ]; } &&
        { [ "$INSTALLER_ACTION" -eq 0 ] || [ -z "${CODEX_WECHAT_DATA_ROOT:-}" ]; }; then
    if [ -L "$DATA_ROOT_FILE" ] || [ ! -f "$DATA_ROOT_FILE" ]; then
        echo "codex-wechat: 数据根标记不是普通文件: $DATA_ROOT_FILE" >&2
        exit 1
    fi
    saved_data_root=$(<"$DATA_ROOT_FILE")
    if [[ -z "$saved_data_root" || "$saved_data_root" != /* ||
          "$saved_data_root" == *$'\n'* || "$saved_data_root" == *$'\r'* ]]; then
        echo "codex-wechat: 数据根标记内容无效: $DATA_ROOT_FILE" >&2
        exit 1
    fi
    if [ -n "${CODEX_WECHAT_DATA_ROOT:-}" ]; then
        requested_data_root=$(realpath -m -- "$CODEX_WECHAT_DATA_ROOT")
        saved_data_root=$(realpath -m -- "$saved_data_root")
        if [ "$requested_data_root" != "$saved_data_root" ]; then
            echo "codex-wechat: CODEX_WECHAT_DATA_ROOT 与安装根 .data-root 不一致；请清除环境变量，或运行 codex-wechat update --reconfigure-roots 显式切换" >&2
            exit 78
        fi
    else
        export CODEX_WECHAT_DATA_ROOT="$saved_data_root"
    fi
fi
if [ "$INSTALLER_ACTION" -eq 0 ] && [ "$ACTION" != "uninstall" ] &&
        [ ! -e "$RUNTIME_ROOTS_FILE" ] &&
        [ ! -e "$DATA_ROOT_FILE" ] && [ ! -L "$DATA_ROOT_FILE" ] &&
        [ -f "$CURRENT_FILE" ]; then
    echo "codex-wechat: 已安装布局缺少运行时路径标记；请重新运行安装器" >&2
    exit 1
fi
if [ "${EUID:-$(id -u)}" -eq 0 ] && [ "${CODEX_WECHAT_ALLOW_ROOT:-}" != "1" ]; then
    case "$ACTION" in
        status|logs|uninstall|-h|--help) ;;
        *)
            echo "codex-wechat: 请以普通用户身份运行，不要使用 root/sudo 或管理员终端。" >&2
            exit 78
            ;;
    esac
fi
case "${1:-}" in
    install|update|menu|components)
        INSTALLER="$INSTALL_ROOT/installer.py"
        if [ ! -f "$INSTALLER" ]; then
            echo "codex-wechat: 稳定安装器缺失: $INSTALLER" >&2
            exit 1
        fi
        exec python3 -u "$INSTALLER" "$@"
        ;;
esac
if [ "$ACTION" = "uninstall" ]; then
    UNINSTALLER="$INSTALL_ROOT/codex_wechat/uninstall.py"
    if [ ! -f "$UNINSTALLER" ]; then
        echo "codex-wechat: 稳定卸载组件缺失: $UNINSTALLER" >&2
        exit 1
    fi
    export CODEX_WECHAT_INSTALL_ROOT="$INSTALL_ROOT"
    shift
    exec env PYTHONPATH="$INSTALL_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
        python3 -B -u -m codex_wechat.uninstall "$@"
fi
if [ -L "$CURRENT_FILE" ]; then
    echo "codex-wechat: 当前版本指针 current 不能是符号链接或重解析点: $CURRENT_FILE" >&2
    exit 1
fi
if [ -e "$CURRENT_FILE" ] && [ ! -f "$CURRENT_FILE" ]; then
    echo "codex-wechat: 当前版本指针 current 必须是普通文件: $CURRENT_FILE" >&2
    exit 1
fi
if [ ! -f "$CURRENT_FILE" ]; then
    echo "codex-wechat: 当前版本指针 current 缺失: $CURRENT_FILE" >&2
    exit 1
fi
if [ -f "$CURRENT_FILE" ]; then
    IFS= read -r RELEASE_ID < "$CURRENT_FILE" || true
    if [[ ! "$RELEASE_ID" =~ ^[a-f0-9]{16}$ ]]; then
        echo "codex-wechat: 当前版本指针 current 包含无效版本标识: $CURRENT_FILE" >&2
        exit 1
    fi
    PROJECT_DIR="$INSTALL_ROOT/releases/$RELEASE_ID"
    if [ ! -f "$PROJECT_DIR/codex_wechat/app.py" ]; then
        echo "codex-wechat: 当前版本不完整: $PROJECT_DIR" >&2
        echo "请从新源码重新运行 update。" >&2
        exit 1
    fi
    if [ ! -e "$RUNTIME_ROOTS_FILE" ]; then
        export CODEX_WECHAT_DATA_ROOT="${CODEX_WECHAT_DATA_ROOT:-$INSTALL_ROOT}"
    fi
fi
export PATH="$HOME/.local/bin:$PATH"
PYTHON=python3
if [ -x "$PROJECT_DIR/.venv/bin/python" ]; then
    PYTHON="$PROJECT_DIR/.venv/bin/python"
fi
exec env PYTHONPATH="$PROJECT_DIR${PYTHONPATH:+:$PYTHONPATH}" \
    "$PYTHON" -u -m codex_wechat "$@"
