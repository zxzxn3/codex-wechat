#!/usr/bin/env bash
# Preserve system PATH defaults while making the existing personal launchers available.
set -euo pipefail
INSTALL_ROOT="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
export CODEX_WECHAT_INSTALL_ROOT="$INSTALL_ROOT"
PYTHON="$INSTALL_ROOT/.bootstrap-venv/bin/python"
if [ ! -x "$PYTHON" ]; then
    echo "codex-wechat: 稳定 Python 环境缺失；请重新运行 bootstrap。" >&2
    exit 1
fi
ACTION="${1:-status}"
if [ "${EUID:-$(id -u)}" -eq 0 ] && [ "${CODEX_WECHAT_ALLOW_ROOT:-}" != "1" ]; then
    case "$ACTION" in
        status|logs|uninstall|-h|--help) ;;
        *)
            echo "codex-wechat: 请以普通用户身份运行，不要使用 root/sudo 或管理员终端。" >&2
            exit 78
            ;;
    esac
fi
case "${1:-}" in
    install|update|menu)
        INSTALLER="$INSTALL_ROOT/installer.py"
        if [ ! -f "$INSTALLER" ]; then
            echo "codex-wechat: 稳定安装器缺失: $INSTALLER" >&2
            exit 1
        fi
        exec "$PYTHON" -u "$INSTALLER" "$@"
        ;;
esac
if [ "$ACTION" = "uninstall" ]; then
    export CODEX_WECHAT_INSTALL_ROOT="$INSTALL_ROOT"
    shift
    exec "$PYTHON" -B -u -m codex_wechat.uninstall "$@"
fi
export PATH="$HOME/.local/bin:$PATH"
exec env CODEX_WECHAT_INSTALL_ROOT="$INSTALL_ROOT" \
    "$PYTHON" -u -m codex_wechat.launcher \
    --install-root "$INSTALL_ROOT" --module codex_wechat -- "$@"
